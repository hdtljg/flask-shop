[Unit]
Description=Flask Shop web application
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/flask-shop
EnvironmentFile=/opt/flask-shop/.env
ExecStart=/opt/flask-shop/.venv/bin/gunicorn --workers 4 --bind 127.0.0.1:8000 --timeout 60 --access-logfile - --error-logfile - wsgi:application
Restart=always
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
