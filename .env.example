# 复制本文件为 .env，然后按实际部署环境修改。
# 注意：.env 不要提交到 Git，也不要在里面保留示例密码。

# Flask session 签名密钥：生产环境必须更换为随机长字符串
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-me-to-a-random-64-char-string

# 数据库连接串（SQLAlchemy 格式）
# 本机 MySQL：mysql+pymysql://用户名:密码@127.0.0.1:3306/flask_data?charset=utf8mb4
# Docker Compose：主机名写 db
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/flask_data?charset=utf8mb4

# 上传目录（可选）。不填则使用项目内 static/img/upload。
# 注意：如果改成外部目录，Nginx/Web 服务器必须把 /static/img/upload/ 映射到该目录，
# 否则页面里的图片会 404。一般保持默认即可。
# UPLOAD_FOLDER=/var/lib/flask-shop/upload

# 单次请求允许上传的最大图片大小（MB）
MAX_CONTENT_LENGTH_MB=16

# 以下仅 docker compose 使用（本地运行可忽略）
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-db
WEB_PORT=8000

# 仅本地调试使用；生产不要开启
# FLASK_DEBUG=0
